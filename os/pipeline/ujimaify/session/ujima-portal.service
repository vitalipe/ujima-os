# managed by the ujima image build — source: os/pipeline/ujimaify/session/ujima-portal.service
#
# The portal bridge (desktop/bin/ujima-portal: org.freedesktop.portal.Desktop -> the ujima picker)
# as a user unit, bound to the session like the shell: i3 `exec`s a restart (one fresh instance per
# session) and the ujimad wrapper stops it before `i3-msg exit`. It needs no X to live, so outside a
# unit a session that died left it holding the bus name and every later portal crash-looped.
[Unit]
Description=ujima portal
StartLimitIntervalSec=0

[Service]
# the picker it spawns per dialog is an X client
Environment=DISPLAY=:0
ExecStart=/ujima/desktop/bin/ujima-portal
Restart=always
RestartSec=1
