#!/bin/sh
# logs: the ujima session's journal. Everything the session prints — ujimad (bb),
# X — shares one inherited stdout tagged `startx`, and the session escapes
# the unit cgroup, so `journalctl -u ujima` MISSES most of it. This filters by
# the identifier + the unit's own lifecycle lines.
#   /ujima/dev/logs                      follow live (last 50 + new)
#   /ujima/dev/logs -b                   everything since boot
#   /ujima/dev/logs --since "1h ago"     any journalctl args pass through
# the shell (desktop/shell, QML errors included) is its own user unit instead:
#   journalctl --user -u ujima-shell
[ $# -eq 0 ] && set -- -f -n 50
exec sudo journalctl --no-hostname "$@" _SYSTEMD_UNIT=ujima.service + SYSLOG_IDENTIFIER=startx
