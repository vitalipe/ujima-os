{:log     {:level :warn}
 :shell   {:commands {}}

 :control {:storage "/ujima/settings/"
           :tmp     "/ujima/run/session"}

 :storage {:mounts-dir "/ujima/run/storage"
           :places     [{:kind :local   :name "storage" :mount "/ujima/storage"
                         :provides {:storage "files/"} :label "UJSTORE" :fstype "ext4"}
                        {:kind :session :name "files"   :mount "/home/ujima/Temporary"
                         :provides {:storage "/"}}]}

 :events  {:audio-poll-ms 1000
           :clock-save-ms 600000}

 :api     {:http {:host "0.0.0.0" :port 1337}
           :auth {:window-ms 60000}}

 :desktop {:launcher    "/ujima/desktop/launcher/bin/ujima-launcher"   ; the home surface, a Qt Quick window (desktop/launcher)
           :portal      "/ujima/desktop/bin/ujima-portal"   ; org.freedesktop.portal.Desktop -> the Qt picker (--pick)
           :places-home "/home/ujima"                       ; the Places screen = home (ujima.desktop.home)

           :http     {:host "127.0.0.1" :port 1336
                      :static-root "/ujima/desktop/shell"}

           :eww      {:eww-config "/ujima/desktop/shell/eww"}

           :app      {:catalog           ["/ujima/apps" "/ujima/storage/apps"]  ; scan order: later root wins
                      :fallback-icon     "/ujima/desktop/shell/icons/launcher.svg"
                      :open-web-app-bin  "/ujima/desktop/bin/ujima-open-web-app"
                      :serve-web-app-bin "/ujima/desktop/bin/ujima-serve-web-app"}}}
