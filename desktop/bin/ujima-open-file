#!/usr/bin/env python3
"""The file handler: xdg-open lands here (via mimeapps.list) for the types the catalog
opens. Without --app the file goes to the Web app as a file:// URL (open-url); with
--app <id> it goes to that catalog app through open-file. Either way ujimad launches
in scope or hands the file to the running instance — never a stray process."""
import json, os, sys, urllib.parse, urllib.request

args = sys.argv[1:]
app = None
if len(args) >= 2 and args[0] == "--app":
    app, args = args[1], args[2:]
if len(args) != 1:
    sys.exit("usage: ujima-open-file [--app <catalog-id>] <path>")
path = os.path.realpath(args[0])
if not os.path.isfile(path):
    sys.exit(f"ujima-open-file: not a file: {path}")

base = "http://127.0.0.1:1336/ujima-desktop/commands/"
if app:
    verb, body = "app/open-file", {"app": app, "path": path}
else:
    verb, body = "app/open-url", {"url": "file://" + urllib.parse.quote(path)}
req = urllib.request.Request(base + verb, data=json.dumps(body).encode(),
                             headers={"content-type": "application/json"})
try:
    urllib.request.urlopen(req, timeout=2).read()
except urllib.error.HTTPError as e:            # loud on stderr; xdg-open ignores our exit anyway
    sys.exit(f"ujima-open-file: {verb} -> {e.code} {e.read().decode(errors='replace')}")
except Exception as e:
    sys.exit(f"ujima-open-file: {e}")
