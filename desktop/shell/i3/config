# UjimaOS — minimal i3 config. No i3bar; the shell (desktop/shell, Qt Quick) is the top bar, dock,
# launcher and lock, ujimad owns app/window lifecycle.
# new windows stack as tabs (cover the previous), never tile-split; font 1 + a
# topbar-matched palette shrink the only surviving decoration — the tab bar — to
# an invisible ~2px sliver that blends into the topbar above it
font pango:Inter 1
default_border none
default_floating_border none
hide_edge_borders both
workspace_layout tabbed
client.focused          #1b2027 #1b2027 #1b2027 #1b2027 #1b2027
client.focused_inactive #1b2027 #1b2027 #1b2027 #1b2027 #1b2027
client.unfocused        #1b2027 #1b2027 #1b2027 #1b2027 #1b2027
client.urgent           #1b2027 #1b2027 #1b2027 #1b2027 #1b2027

# real dialogs float. Deliberately NO fullscreen keybind — the bars must stay visible, and
# apps that must not own the screen (Stellarium) launch windowed instead (their app.edn).
# chromium --app windows auto-float (fixed size hints) but set class/role only AFTER mapping, so
# for_window can't catch them here — ujimad un-floats app windows instead (settle-floaters!).
# NO `assign` rules: ujimad routes each window to its app's workspace by WM_CLASS at runtime
# (route-windows!), so a new app needs no config edit + reload — just a catalog entry.
for_window [window_type="dialog"]  floating enable
for_window [window_type="utility"] floating enable
# open/save file choosers overflow the bars when floated (buttons hide behind the dock) — TILE them
# instead: a tiled window fills exactly the band between the top bar and dock at any resolution
# (i3's dock areas hold the bars), so no hardcoded size. Targets the GTK chooser role so small
# confirm dialogs still float.
for_window [window_role="GtkFileChooserDialog"] floating disable

# the top bar and the dock are i3 docks (desktop/shell types them): i3 holds their space, so the
# launcher + apps get the band between, an i3-fullscreen app covers them, and unmapping them (solo,
# lock) hands their space over — no gaps to keep in sync. The shell's managed windows (WM_CLASS
# ujima-shell) are placed by title before they ever map, so a shell restarting under an app never
# covers it or takes its focus; ujimad routes them too.
assign [class="^ujima-shell$" title="^Launcher$"] 1
assign [class="^ujima-shell$" title="^Lock$"] lock

# super+space cycles the keyboard layout — through ujimad (concrete-state POST),
# NEVER an XKB group toggle: X-side switching would drift from the control plane
# and the next converge would snap it back.
bindsym Mod4+space exec --no-startup-id ujima-kbd-next

# app chords — every chord is a dumb key->ujimad-verb map (ujima-desktop), NEVER a raw i3 command:
# ujimad stays the single policy gate (a future lesson-pin refuses keyboard, dock and LAN
# alike), and the X-level grabs land even over fullscreen windows (where the bars hide) and
# inside kiosk chromium. Alt+F4 rides the topbar ✕'s exact close path (incl. the 1-3s ✕✕
# force window); Alt+Tab cycles the RUNNING apps in catalog (= dock) order — home is not a stop;
# Alt+Esc goes home — the one NON-destructive keyboard exit when a sole fullscreen app hides the
# bars (Alt+Tab no-ops on a ring of one; the app keeps running on its workspace).
bindsym Mod1+F4        exec --no-startup-id ujima-desktop POST commands/app/close >/dev/null
bindsym Mod1+Tab       exec --no-startup-id ujima-desktop POST commands/app/next >/dev/null
bindsym Mod1+Shift+Tab exec --no-startup-id ujima-desktop POST commands/app/prev >/dev/null
bindsym Mod1+Escape    exec --no-startup-id ujima-desktop POST commands/app/home >/dev/null

# desktop background: the launcher's gradient (desktop/shell/wall.svg, rasterized to wall.png by
# os.desktop) set on the X root. i3 draws over it, so empty workspaces show the gradient
# instead of the black root — the transparent top bar shows it through, and the launcher paints the
# same image aligned to it, one continuous background under everything.
exec_always --no-startup-id feh --bg-fill /ujima/desktop/shell/wall.png

# ujimad reconciles settings and serves the shell's tier; the session's user units (the shell, the
# portal) are ujima-session.target, restarted here so every session gets fresh ones (the ujimad
# wrapper stops it on the way out)
exec --no-startup-id ujimad
exec --no-startup-id systemctl --user restart ujima-session.target

# compositor: picom — transparency for the shell's surfaces, fades, the tooltip card and the dialog
# treatment (a floating dialog is a card, its app dims behind it). All of it in shell/picom.conf.
exec_always --no-startup-id picom --config /ujima/desktop/shell/picom.conf
