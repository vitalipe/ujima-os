;; The shell's state matrix: every state the bars and the lock card render, as facts the sim
;; turns into ujimad's own settings and app projections. A state is merged over :base.
;; :apps     — :open (ids), :focused (an id, or nil = home), :titles,
;;             :mode (:multi | :solo | :locked), :console (pinned once a token unhides it)
;; :settings — :name, :output (:hdmi | :usb | nil = no output), :volume, :muted, :layouts,
;;             :layout, :locked (a subset of #{:volume :muted :output :layout} = pinned by an
;;             activity)
;; :hover    — a pointer rests on a named target before the capture
{:base
 {:apps     {:open [] :focused nil :titles {} :mode :multi :console false}
  :settings {:name "UjimaOS" :output :hdmi :volume 60 :muted false
             :layouts ["us" "il" "ru"] :layout "us" :locked #{}}}

 :states
 [;; --- the top bar and the dock
  {:name "home" :doc "nothing focused: bare top bar, launcher tile lit"}
  {:name "home-with-apps" :doc "apps open behind home: their tiles subtle, none active"
   :apps {:open [:geany :gimp :write]}}
  {:name "app" :doc "an app in front: icon, title, close; its tile blooms"
   :apps {:open [:geany] :focused :geany}}
  {:name "app-long-title" :doc "a title wider than the bar"
   :apps {:open [:geany] :focused :geany
          :titles {:geany "a-very-long-file-name-that-keeps-going-and-going-past-any-reasonable-width-for-a-title-bar.py — /home/ujima/projects/an/equally/deep/directory/tree/that/nobody/asked/for - Geany"}}}
  {:name "focus-learn"   :apps {:open [:tuxtype :marble :write :gimp :geany] :focused :tuxtype}}
  {:name "focus-explore" :apps {:open [:tuxtype :marble :write :gimp :geany] :focused :marble}}
  {:name "focus-office"  :apps {:open [:tuxtype :marble :write :gimp :geany] :focused :write}}
  {:name "focus-create"  :apps {:open [:tuxtype :marble :write :gimp :geany] :focused :gimp}}
  {:name "focus-code"    :apps {:open [:tuxtype :marble :write :gimp :geany] :focused :geany}}
  {:name "many-apps" :doc "every tile app open"
   :apps {:open [:tuxtype :marble :stellarium :web :xaos :write :calc :impress :onlyoffice
                 :draw :gimp :inkscape :excalidraw :geany :thonny :godot :turbowarp]
          :focused :stellarium}}
  {:name "files-focused" :doc "a pinned (system) app in front: its pinned button lit, no centre tile"
   :apps {:open [:files :geany] :focused :files}}
  {:name "console-pinned" :doc "a token unhid the console: a second pinned button"
   :apps {:console true :open [:geany] :focused :geany}}
  {:name "console-focused" :apps {:console true :open [:console] :focused :console}}

  ;; --- the keyboard
  {:name "kbd-one-layout" :doc "nothing to choose: no reveal"
   :settings {:layouts ["us"] :layout "us"}}
  {:name "kbd-rotated" :doc "the current layout is last in the switcher"
   :settings {:layout "il"}}
  {:name "kbd-locked" :doc "pinned: padlock, no reveal, inert"
   :settings {:layout "il" :locked #{:layout}}}

  ;; --- the sound
  {:name "vol-0"   :settings {:volume 0}}
  {:name "vol-30"  :settings {:volume 30}}
  {:name "vol-80"  :settings {:volume 80}}
  {:name "vol-usb" :doc "the other output class holds its own level" :settings {:output :usb :volume 45}}
  {:name "muted"   :settings {:muted true}}
  {:name "no-output" :doc "\"--\", the track dimmed" :settings {:output nil}}
  {:name "vol-locked" :settings {:locked #{:volume}}}
  {:name "muted-locked" :settings {:muted false :locked #{:muted}}}
  {:name "muted-and-muted-locked" :doc "the well is suppressed" :settings {:muted true :locked #{:muted}}}
  {:name "vol-locked-muted" :settings {:muted true :locked #{:volume}}}
  {:name "everything-locked" :settings {:muted true :layout "ru" :locked #{:volume :muted :output :layout}}}

  ;; --- the reveals and the tooltip card, under a resting pointer (:hover names a target)
  {:name "vol-open" :hover :volume}
  {:name "vol-open-muted" :hover :volume :settings {:muted true}}
  {:name "vol-open-locked" :hover :volume :settings {:locked #{:volume}}}
  {:name "vol-open-no-output" :hover :volume :settings {:output nil}}
  {:name "vol-open-muted-locked" :doc "no well, no slider" :hover :volume :settings {:muted true :locked #{:muted}}}
  {:name "kbd-open" :hover :keyboard}
  {:name "kbd-open-locked" :doc "no reveal" :hover :keyboard :settings {:locked #{:layout}}}
  {:name "tooltip-close" :hover :close :apps {:open [:geany] :focused :geany}}
  {:name "tooltip-home" :hover :home}

  ;; --- what is shown at all
  {:name "solo" :doc "one app held: no bars" :apps {:open [:geany] :focused :geany :mode :solo}}
  {:name "locked" :doc "the lock card, no bars" :apps {:open [:geany] :mode :locked}}]

 ;; What a click must send.
 ;; :click names a target; :expect is every POST the sim logs after it, in order.
 :checks
 [{:name "close"         :state "app"          :click :close   :expect [["POST /commands/app/close" nil]]}
  {:name "home-tile"     :state "app"          :click :home    :expect [["POST /commands/app/home" nil]]}
  {:name "pinned-tile"   :state "home"         :click :files   :expect [["POST /commands/app/open" {:app "files"}]]}
  {:name "mute"          :state "home"         :click :volume  :expect [["POST /commands/audio/muted" {:value true}]]}
  {:name "unmute"        :state "muted"        :click :volume  :expect [["POST /commands/audio/muted" {:value false}]]}
  {:name "mute-pinned"   :state "muted-locked" :click :volume  :expect []}
  {:name "layout-next"   :state "home"         :click :kbd     :expect [["POST /commands/keyboard/layout" {:layout "il"}]]}
  {:name "layout-pinned" :state "kbd-locked"   :click :kbd     :expect []}
  {:name "volume-drag" :doc "first value at once, at most one per 250 ms, the last on release"
   :state "home" :drag [0.15 0.85] :expect :volume-drag}
  {:name "volume-drag-unmutes" :state "muted" :drag [0.3 0.6] :expect :volume-drag-unmute}]}
